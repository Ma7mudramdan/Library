@model IEnumerable<LibraryManagementSystem.Models.Borrowing>

@{
    ViewData["Title"] = "Borrowing History";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>@ViewData["Title"]</h1>
                @if (ViewBag.MemberName != null)
                {
                    <h4>Member: @ViewBag.MemberName</h4>
                }
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Member</th>
                                    <th>Book</th>
                                    <th>Borrow Date</th>
                                    <th>Expected Return</th>
                                    <th>Actual Return</th>
                                    <th>Status</th>
                                    <th>Late Fee</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Member?.FullName</td>
                                        <td>@item.Book?.Title</td>
                                        <td>@item.BorrowDate.ToShortDateString()</td>
                                        <td>@item.ExpectedReturnDate.ToShortDateString()</td>
                                        <td>@(item.ActualReturnDate?.ToShortDateString() ?? "Not Returned")</td>
                                        <td>
                                            @if (item.Status == "Borrowed")
                                            {
                                                <span class="badge bg-warning">Borrowed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Returned</span>
                                            }
                                        </td>
                                        <td>@item.LateFee.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to Borrowings
                </a>
            </div>
        </div>
    </div>
</div>